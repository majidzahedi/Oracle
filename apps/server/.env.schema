# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# @type=string(minLength=32)
BETTER_AUTH_SECRET=

# @type=url
BETTER_AUTH_URL=

# @type=url
CORS_ORIGIN=

# Only needed for LLM calls (AI example route, the Oracle in stage 5)
# @type=string(minLength=1) @optional
GOOGLE_GENERATIVE_AI_API_KEY=

# @type=string(minLength=1)
DATABASE_URL=

# --- Inngest ---
# Set to true locally to talk to the Inngest Dev Server (v4 defaults to cloud mode)
# @type=boolean @optional @sensitive=false
INNGEST_DEV=true

# Dev Server / self-hosted base URL (unset in cloud)
# @type=url @optional @sensitive=false
INNGEST_BASE_URL=

# Required in production (cloud mode)
# @optional
INNGEST_SIGNING_KEY=

# @optional
INNGEST_EVENT_KEY=

# --- Phase timers (seconds) ---
# @type=number @optional @sensitive=false
PHASE_NIGHT_SECONDS=45
# @type=number @optional @sensitive=false
PHASE_DAY_SECONDS=210
# @type=number @optional @sensitive=false
PHASE_ACTION_SECONDS=90
# @type=number @optional @sensitive=false
PHASE_VOTE_SECONDS=60
# @type=number @optional @sensitive=false
PHASE_FINAL_SECONDS=60
