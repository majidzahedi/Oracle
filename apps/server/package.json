{
	"name": "server",
	"type": "module",
	"main": "src/index.ts",
	"scripts": {
		"build": "tsc -b ../../packages/api && tsdown",
		"check-types": "tsc -b ../../packages/api && tsc --noEmit",
		"compile": "bun build --compile --no-compile-autoload-dotenv --minify --sourcemap --bytecode ./src/index.ts --outfile server",
		"dev": "bun run --hot src/index.ts",
		"start": "bun run dist/index.mjs",
		"env:generate": "varlock codegen",
		"auth:generate": "varlock run -- bun x auth@latest generate --config src/services.ts --output ../../packages/db/src/schema/auth.ts --yes",
		"smoke:inngest": "bun run scripts/smoke-inngest.ts"
	},
	"dependencies": {
		"@ai-sdk/devtools": "^1.0.15",
		"@ai-sdk/google": "^4.0.64",
		"@oracle/api": "workspace:*",
		"@oracle/auth": "workspace:*",
		"@oracle/db": "workspace:*",
		"@orpc/openapi": "catalog:",
		"@orpc/server": "catalog:",
		"@orpc/zod": "catalog:",
		"ai": "catalog:",
		"better-auth": "catalog:",
		"hono": "^4.13.7",
		"inngest": "4.23.0",
		"varlock": "catalog:",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@oracle/config": "workspace:*",
		"@types/bun": "catalog:",
		"tsdown": "^0.23.0",
		"typescript": "catalog:"
	}
}
