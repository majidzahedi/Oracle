{
	"name": "oracle",
	"private": true,
	"workspaces": {
		"packages": [
			"apps/*",
			"packages/*"
		],
		"catalog": {
			"zod": "^4.5.4",
			"typescript": "^6.0.3",
			"@types/bun": "^1.4.2",
			"varlock": "1.18.0",
			"@orpc/server": "^1.15.0",
			"@orpc/openapi": "^1.15.0",
			"@orpc/zod": "^1.15.0",
			"better-auth": "1.7.7",
			"ai": "^7.0.93",
			"lucide-react": "^1.41.0",
			"next-themes": "^0.4.6",
			"react": "^19.2.8",
			"react-dom": "^19.2.8",
			"sonner": "^2.0.8",
			"@orpc/client": "^1.15.0",
			"@types/react": "^19.2.18",
			"@types/react-dom": "^19.2.7",
			"tailwindcss": "^4.3.3",
			"drizzle-orm": "1.0.0-rc.4"
		}
	},
	"type": "module",
	"scripts": {
		"dev": "turbo run dev",
		"build": "turbo run build",
		"check-types": "turbo run check-types",
		"dev:web": "turbo run dev -F web --",
		"dev:server": "turbo run dev -F server --",
		"db:push": "turbo run db:push -F @oracle/db --",
		"db:studio": "turbo run db:studio -F @oracle/db --",
		"db:generate": "turbo run db:generate -F @oracle/db --",
		"db:migrate": "turbo run db:migrate -F @oracle/db --",
		"db:start": "turbo run db:start -F @oracle/db --",
		"db:watch": "turbo run db:watch -F @oracle/db --",
		"db:stop": "turbo run db:stop -F @oracle/db --",
		"db:down": "turbo run db:down -F @oracle/db --",
		"env:generate": "varlock codegen --path ./apps/web/ && varlock codegen --path ./apps/server/ && varlock codegen --path ./packages/db/",
		"postinstall": "varlock codegen --path ./apps/web/ && varlock codegen --path ./apps/server/ && varlock codegen --path ./packages/db/",
		"auth:generate": "cd apps/server && bun run auth:generate",
		"check": "biome check --write .",
		"dev:inngest": "inngest-cli dev --no-discovery -u http://localhost:3000/api/inngest",
		"test": "turbo run test"
	},
	"dependencies": {
		"zod": "catalog:"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.12",
		"@oracle/config": "workspace:*",
		"@types/bun": "catalog:",
		"inngest-cli": "^1.46.0",
		"turbo": "^2.10.12",
		"typescript": "catalog:",
		"varlock": "catalog:"
	},
	"packageManager": "bun@1.4.2",
	"trustedDependencies": [
		"inngest-cli"
	]
}
