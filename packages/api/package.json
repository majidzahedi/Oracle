{
	"name": "@oracle/api",
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./*": "./src/*.ts"
	},
	"scripts": {
		"build": "tsc -b",
		"check-types": "tsc -b && tsc --noEmit -p tsconfig.check.json",
		"test": "vitest run"
	},
	"dependencies": {
		"@oracle/auth": "workspace:*",
		"@oracle/db": "workspace:*",
		"@orpc/client": "catalog:",
		"@orpc/openapi": "catalog:",
		"@orpc/server": "catalog:",
		"@orpc/zod": "catalog:",
		"zod": "catalog:",
		"@oracle/engine": "workspace:*",
		"@oracle/realtime": "workspace:*",
		"drizzle-orm": "catalog:",
		"inngest": "4.23.0",
		"@oracle/oracle": "workspace:*"
	},
	"devDependencies": {
		"@oracle/config": "workspace:*",
		"typescript": "catalog:",
		"vitest": "5.0.3"
	}
}
